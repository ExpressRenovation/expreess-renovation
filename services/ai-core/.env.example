# ===========================================================================
# ai-core — variables de entorno (Express Renovation)
#
# Arquitectura: Cloud Run SERVICE (dispatcher HTTP) + Cloud Run JOB
# (`ai-core-worker`, corre el pipeline pesado). Ambos comparten imagen.
#
# En Cloud Run NO se setean credenciales aquí: cada recurso corre como su
# service account y todo resuelve por Application Default Credentials (ADC).
# Para local: `gcloud auth application-default login` (preferido) o rellenar
# el bloque FIREBASE_* con una key descargada.
#
# IA = Vertex AI (google-genai con vertexai=True). NO se usa API key de Gemini.
# ===========================================================================

# --- Proyecto / Firebase Admin ---------------------------------------------
FIREBASE_PROJECT_ID="express-renovation"
# Opcional (solo local, si no se usa ADC). Mantener los \n literales en la key.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Vertex AI (Gemini) -----------------------------------------------------
# Debe ser la región que aloja Firestore para que datos e inferencia queden
# juntos y dentro de la UE.
VERTEX_LOCATION="europe-southwest1"

# --- Retrieval (catálogo / price book) -------------------------------------
# EMBEDDING_MODEL debe coincidir con el modelo que indexó las colecciones;
# vectores de modelos distintos no son comparables (falla en silencio).
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"
PRICE_BOOK_COLLECTION="price_book_items"

# --- Pipeline Jobs (SERVICE dispatcher) ------------------------------------
# Secreto compartido con Next.js (Server Action -> ai-core). Gatea /api/v1/jobs/*
# y /api/v1/admin/*. Vacío en local = acceso permitido (no bloquear dev).
INTERNAL_WORKER_TOKEN=""
# Ruta completa del Cloud Run Job que dispara el dispatcher. La setea
# cloudbuild.yaml; para local/manual:
WORKER_JOB_NAME="projects/express-renovation/locations/europe-southwest1/jobs/ai-core-worker"
# Bucket GCS para los PDFs subidos (lo crea setup-infrastructure). Fallback:
# FIREBASE_STORAGE_BUCKET.
PIPELINE_UPLOADS_BUCKET="express-renovation-pipeline-uploads"

# --- Pipeline Jobs (WORKER / Cloud Run Job) --------------------------------
# Cadencia de heartbeat (updatedAt) y de poll de cancelación.
PIPELINE_HEARTBEAT_SECONDS="30"
PIPELINE_CANCEL_POLL_SECONDS="5"
# Flags Sprint 4 (parser tabular coord-based + tope de páginas por visión).
USE_TABULAR_PARSER="true"
MAX_LLM_VISION_PAGES="50"
