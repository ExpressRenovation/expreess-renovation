# ---------------------------------------------------------------------------
# ai-core — local development only.
#
# On Cloud Run NONE of these are set: the service runs as its own service
# account and everything below resolves through Application Default
# Credentials. Do not ship a service-account key with the container.
#
# For local work, either run `gcloud auth application-default login` (preferred,
# no key on disk) or fill in the FIREBASE_* block with a downloaded key.
# ---------------------------------------------------------------------------

# GCP project. On Cloud Run this comes from the metadata server.
FIREBASE_PROJECT_ID="express-renovation"

# Optional: explicit service-account key for local development.
# Leave empty to use Application Default Credentials instead.
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Vertex AI region. Must be the region holding Firestore so data and inference
# stay together (and inside the EU).
VERTEX_LOCATION="europe-southwest1"

# Embedding model. This MUST match the model that indexed the collections —
# vectors from different models are not comparable, and mismatches fail
# silently with plausible-looking but wrong results.
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"

# Firestore collection holding the price book vectors.
PRICE_BOOK_COLLECTION="price_book_items"
