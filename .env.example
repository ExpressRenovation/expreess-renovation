# ===========================================================================
# Express Renovation Mallorca — environment variables
#
# Copy to `.env` for local development. On Vercel, set these under
# Settings → Environment Variables. `.env*` is gitignored.
#
# GCP project: express-renovation (nº 797056263958)
# Firestore:   europe-southwest1 (Madrid)
# ===========================================================================

# --- Firebase web SDK (browser) --------------------------------------------
# From the "Express Renovation Web" app in the Firebase console. These are
# public by design — the browser needs them, and Firestore security rules are
# what actually protects the data.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyAI57qxGJZTm7Q4o4-oMTlIXrrWyuNGaC0"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="express-renovation.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="express-renovation"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="express-renovation.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="797056263958"
NEXT_PUBLIC_FIREBASE_APP_ID="1:797056263958:web:f92823d59b5bea26b09237"

# --- Site ------------------------------------------------------------------
# Canonical origin, including `www`. Drives canonical tags, hreflang, sitemap
# and robots.txt — a mismatch here silently breaks indexing.
NEXT_PUBLIC_APP_URL="https://www.expressrenovationmallorca.es"
NEXT_PUBLIC_SITE_URL="https://www.expressrenovationmallorca.es"

# Set to "true" to point the app at test collections instead of production.
NEXT_PUBLIC_USE_TEST_DB="false"

# --- Firebase Admin (server) -----------------------------------------------
# Used by server actions to reach Firestore and Storage with the Admin SDK.
#
# The `vercel-app@express-renovation.iam.gserviceaccount.com` service account
# exists with the minimum roles needed (datastore.user, storage.objectAdmin,
# cloudtasks.enqueuer). Note the organisation enforces
# `iam.disableServiceAccountKeyCreation`, so downloading a key requires an
# explicit policy exception.
#
# Keep the literal \n escapes in the private key; the code un-escapes them.
FIREBASE_PROJECT_ID="express-renovation"
GCLOUD_PROJECT="express-renovation"
FIREBASE_STORAGE_BUCKET="express-renovation.firebasestorage.app"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# --- Gemini ----------------------------------------------------------------
# Genkit and the price-book vectorizer authenticate to the Gemini Developer API
# with this key. Create it in Google AI Studio against the express-renovation
# project. (ai-core does NOT need it — on Cloud Run it uses Vertex AI through
# its own service identity.)
GOOGLE_GENAI_API_KEY=""

# --- ai-core (Cloud Run) ---------------------------------------------------
# Python service handling PDF measurement extraction and AI budget pricing.
# The token must match the `ai-core-service-token` secret in Secret Manager;
# without it the service returns 401.
AI_CORE_URL="https://ai-core-797056263958.europe-southwest1.run.app"
AI_CORE_SERVICE_TOKEN=""

# --- Cloud Tasks -----------------------------------------------------------
GCP_TASKS_LOCATION="europe-southwest1"
GCP_TASKS_QUEUE=""

# --- Admin -----------------------------------------------------------------
# Guards the maintenance actions under /actions/debug. No default: the code
# refuses to run without it.
ADMIN_SECRET=""

# --- Optional integrations -------------------------------------------------
# WhatsApp Business (Meta). Leave empty to disable.
META_ACCESS_TOKEN=""
META_PHONE_NUMBER_ID=""

# Google Workspace admin used for calendar impersonation. Leave empty to disable.
GOOGLE_WORKSPACE_ADMIN_EMAIL=""
